{
  "tasks": {
    "build": "deno run --allow-env --allow-run --allow-write --allow-read ./scripts/bundle.ts",
    "install": "deno run --allow-env --allow-run --allow-write --allow-read ./scripts/install.ts",
    "clear-old-scripts": "rm ~/bin/old-scripts/termux-file-editor-* ~/bin/old-scripts/termux-url-opener-*"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "esbuild": "npm:esbuild"
  }
}
